# Copy to .env and adjust. Never commit the real .env.
# Every value is validated at startup; the app refuses to boot on a bad one.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# SQLite file. The container overrides this to sqlite:////data/route53.db
DATABASE_URL=sqlite:///./data/route53.db

# --- Sessions -----------------------------------------------------------
SESSION_COOKIE_NAME=r53_session
SESSION_TTL_HOURS=12
# Must be true in production so the cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Local development only ---------------------------------------------
# In production Next.js proxies /api/*, so no cross-origin request is made.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Limits --------------------------------------------------------------
LOGIN_RATE_LIMIT=5/minute
# Production keeps the stricter defaults (10/minute and 30/minute); the
# end-to-end suite creates an account per test.
SIGN_UP_RATE_LIMIT=100/minute
DEMO_RATE_LIMIT=100/minute
MAX_IMPORT_BYTES=1048576

# --- Demo data -----------------------------------------------------------
# The shared local account below. "Try the demo" always uses private accounts.
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@route53-clone.dev
DEMO_USER_PASSWORD=change-me-locally
# Shared account data older than this is reset at its next sign-in.
DEMO_RESET_INTERVAL_HOURS=24

# --- Litestream (production only) ----------------------------------------
# Supabase Storage S3 credentials. Set these in the Render dashboard, never here.
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
