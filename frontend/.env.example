# Copy to .env.local for local development. Never commit the real file.

# Where Next.js forwards /api/* requests. Server-side only: this value is
# never sent to the browser, which is why it has no NEXT_PUBLIC_ prefix.
BACKEND_URL=http://localhost:8000

# Shown as a small badge so a local build is never mistaken for production.
NEXT_PUBLIC_APP_ENV=development
